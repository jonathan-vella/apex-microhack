---
import StarlightFooter from "@astrojs/starlight/components/Footer.astro";
---

<StarlightFooter {...Astro.props}>
  <slot />
</StarlightFooter>

<script>
  let mermaidModulePromise;

  function loadMermaid() {
    mermaidModulePromise ??= import("mermaid").then(({ default: mermaid }) => mermaid);
    return mermaidModulePromise;
  }

  function getTheme() {
    return document.documentElement.dataset.theme === "light" ? "default" : "dark";
  }

  async function renderMermaid(nodes) {
    const elements = nodes ?? document.querySelectorAll(".mermaid");
    if (elements.length === 0) return;

    const mermaid = await loadMermaid();

    elements.forEach((el) => {
      if (!el.getAttribute("data-original")) {
        el.setAttribute("data-original", el.textContent || "");
      }
    });

    mermaid.initialize({ startOnLoad: false, theme: getTheme() });

    try {
      await mermaid.run({ nodes: elements });
    } catch (e) {
      console.warn("Mermaid render error:", e);
    }
  }

  // Diagrams pull in a heavy layout engine, so only fetch and render them once
  // they scroll near the viewport instead of on every page load.
  function observeMermaid() {
    const elements = document.querySelectorAll(".mermaid");
    if (elements.length === 0) return;

    if (!("IntersectionObserver" in window)) {
      renderMermaid(elements);
      return;
    }

    const observer = new IntersectionObserver(
      (entries, obs) => {
        const pending = entries
          .filter((entry) => entry.isIntersecting)
          .map((entry) => entry.target);
        if (pending.length === 0) return;
        pending.forEach((el) => obs.unobserve(el));
        renderMermaid(pending);
      },
      { rootMargin: "200px" },
    );
    elements.forEach((el) => observer.observe(el));
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", observeMermaid);
  } else {
    observeMermaid();
  }

  // Re-render on theme change
  const observer = new MutationObserver(async () => {
    document.querySelectorAll(".mermaid").forEach((el) => {
      el.removeAttribute("data-processed");
      el.innerHTML = el.getAttribute("data-original") || "";
    });
    await renderMermaid();
  });
  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });
</script>
