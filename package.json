  },
  "devDependencies": {
    "lefthook": "^2.2.2",
    "markdownlint-cli2": "^0.24.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2"
  },
  "overrides": {
    "smol-toml": "^1.9.1"
  }
}
